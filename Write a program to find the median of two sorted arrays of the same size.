import java.util.Scanner;
public class Main{
    public static void main(String[]args){
        Scanner sc = new Scanner(System.in);
        int n=sc.nextInt();
        long arr1[]= new long[n];
        long arr2[]=new long [n];
        for(int i=0;i<n;i++){
            arr1[i]=sc.nextLong();
        }
        for(int i=0;i<n;i++){
            arr2[i]=sc.nextLong();
        }
        long arr3[]=new long[2*n];
        for(int i=0;i<n;i++){
            arr3[i]=arr1[i];
        }
        for(int i=0;i<n;i++){
            arr3[n+i]=arr2[i];
        }
        for(int i=0;i<2*n-1;i++){
            for(int j=0;j<2*n-1-i;j++){
                if(arr3[j]>arr3[j+1]){
                    long temp=arr3[j];
                    arr3[j]=arr3[j+1];
                    arr3[j+1]=temp;
                }
            }
        }
        int mid=(2*n)/2;
        long median=(arr3[mid-1]+arr3[mid])/2;
        System.out.println(median);
    }
}
