import java.util.Scanner;
public class Main{
    public static void main(String[]args){
        Scanner sc= new Scanner(System.in);
        int n=sc.nextInt();
        int sum=0;
        long prod=1;
        for(int i=1;i<=n;i++){
            sum=sum+i;
            prod=prod*i;
        }
        if(prod%sum==0){
            System.out.println("Yes");
        }
        else{
            System.out.println("No");
        }
    }
}
