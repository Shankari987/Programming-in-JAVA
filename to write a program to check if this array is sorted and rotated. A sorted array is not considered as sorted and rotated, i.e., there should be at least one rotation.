import java.util.Scanner;
public class Main{
    public static void main(String[]args){
        Scanner sc =new Scanner(System.in);
        int n=sc.nextInt();
        long arr[]= new long[n];
        for(int i=0;i<n;i++){
            arr[i]=sc.nextLong();
        }
        long k=sc.nextLong();
        int index=-1;
        for(int i=n-1;i>0;i--){
            if(arr[i]==k){
                index=n-1-i;
                break;
            }
        }
        System.out.println(index);
    }
}
