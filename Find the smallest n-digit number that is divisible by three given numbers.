import java.util.Scanner;
public class Main{
    public static void main(String[]args){
        Scanner sc= new Scanner(System.in);
        int n=sc.nextInt();
        int n1=sc.nextInt();
        int n2=sc.nextInt();
        int n3=sc.nextInt();
        int start;
        if(n==1){
            start=1;
        }
        else if(n==2){
            start=10;
        }
        else if(n==3){
            start=100;
        }
        else{
            start=1000;
        }
        for (int i=start ; ;i++){
            if(i%n1==0 && i%n2==0 &&i%n3==0){
                System.out.println(i);
                break;
            }
        }
    }
}
