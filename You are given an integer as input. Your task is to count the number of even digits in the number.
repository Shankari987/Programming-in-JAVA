import java.util.Scanner;
public class Main{
    public static void main(String[]args){
        Scanner sc= new Scanner(System.in);
        int count=0;
        long num=sc.nextLong();
        while(num!=0){
            long digit=num%10;
            if(digit%2==0){
                count++;
            }
            num=num/10;
        }
        System.out.println(count);
    }
}
