import java.util.Scanner;
public class Main{
    public static void main(String[]args){
        Scanner sc=new Scanner(System.in);
        long num=sc.nextLong();
        long prod=1;
        while(num!=0){
            long digit=num%10;
            prod=prod*digit;
            num=num/10;
        }
        System.out.println(prod);
    }
}
