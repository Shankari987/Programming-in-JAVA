import java.util.Scanner;
public class Main{
    public static void main(String[]args){
        Scanner sc= new Scanner(System.in);
        int n=sc.nextInt();
        long arr[]=new long[n];
        for(int i=0;i<n;i++){
            arr[i]=sc.nextLong();
        }
        long k=sc.nextLong();
        for(int i=0;i<n;i++){
            arr[i]=arr[i]%k;
            System.out.print(arr[i]+" ");
        }
    }
}
