import java.util.Scanner;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int q = sc.nextInt();
        for (int j = 0; j < q; j++) {
            int n = sc.nextInt();
            int sum = 0;
            for (int i = 1; i <= n; i++) {
                if (n % i == 0) {
                    int temp = i;
                    while (temp > 0) {
                        int digit = temp % 10;
                        if (digit % 2 != 0) {
                            sum = sum + digit;
                        }
                        temp = temp / 10;
                    }
                }
            }
            System.out.println(sum);
        }
    }
}
